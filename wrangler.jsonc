/*
  Celpare on Cloudflare Workers through OpenNext (D15). Phase OPS, step 0.

  - nodejs_compat: Next's server code and src/proxy.ts need Node APIs.
  - global_fetch_strictly_public: a fetch to our own hostname goes out to the
    public internet rather than looping back into this Worker.
  - workers_dev false: production is served only on celpare.com, behind the
    zone's WAF and rate limits. A *.workers.dev address would bypass both.
  - preview_urls true: each uploaded version gets its own preview URL for PR
    checks. These go behind Cloudflare Access before any are made.
  - compatibility_date matches the workerd that wrangler 4.156.0 ships, so
    local and deployed behaviour agree. Move it forward on purpose, not by habit.

  Secrets are never written here. They are set with `wrangler secret put` by the
  founder, or live in .dev.vars locally (gitignored).
*/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celpare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": true,
  /* Production hostname. A zone route, not a custom domain: the apex already
     has a proxied placeholder A record (192.0.2.1) in the celpare.com zone,
     which a route sits on top of and a custom domain would have to replace.
     Mail records are untouched either way. Live only after the first approved
     deploy; until then the placeholder keeps answering. */
  "routes": [
    { "pattern": "celpare.com/*", "zone_name": "celpare.com" }
  ],
  /* Off, against wrangler's default. With keep_names, esbuild wraps functions
     in __name(...) calls. next-themes ships its no flash theme script as a
     function turned into an inline <script> string, so the browser ran
     __name with no definition: "ReferenceError: __name is not defined" on
     every page (found live 2026-11-07), and the theme was set only after
     hydration. Nothing in the app reads Function.name. */
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      /* Self reference, used by OpenNext's caching. Must match "name". */
      "binding": "WORKER_SELF_REFERENCE",
      "service": "celpare"
    }
  ],
  "r2_buckets": [
    {
      /* Incremental cache. Simulated locally by wrangler dev; the bucket is
         created in the account only with founder approval, before a deploy. */
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "celpare-opennext-cache"
    }
  ],
  "images": {
    /* next/image optimisation through Cloudflare Images. */
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
