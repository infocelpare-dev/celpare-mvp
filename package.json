    "test:onboarding": "node --import ./scripts/test-loader.mjs --test \"src/lib/onboarding/__tests__/*.test.ts\"",
    "test:billing": "node --import ./scripts/test-loader.mjs --test \"src/lib/billing/__tests__/*.test.ts\"",
